# Puerto del backend
PORT=3000

# Credenciales de la app OAuth2 de Google (Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Refresh token obtenido una vez autorizada la app (ver README, sección "Configurar Google Drive")
GOOGLE_REFRESH_TOKEN=

# ID de la carpeta raíz "JavaLab" en Google Drive.
# Se puede dejar vacío la primera vez: el backend la crea automáticamente
# y te muestra el ID en consola para que lo copies aquí.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Clave para el servicio de IA (generación de ejercicios, tutor, pistas)
# Deja vacío para correr la app en "modo offline" con generación local de ejercicios de respaldo.
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages

# Secreto para firmar sesiones simples (cámbialo en producción)
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo
